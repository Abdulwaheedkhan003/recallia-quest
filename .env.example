# ================= Server =================
PORT=8787
# DATABASE_PATH=data/recallia.db
# STORAGE_DIR=data/storage
# MAX_UPLOAD_MB=50
# STORAGE_QUOTA_MB=2048

# ---- Required for a public (HTTPS) deployment ----
# APP_ORIGIN=https://recallia.example.org     # your public origin (comma-separate several)
# COOKIE_SECURE=true                          # sessions only over HTTPS + HSTS
# TRUST_PROXY=1                               # when behind one reverse proxy (nginx, Caddy, a load balancer)

# ================= AI (Companion, reminders from chat, Story Time, Doctor Helper chat) =================
# Option A — Anthropic
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5           # or claude-haiku-4-5-20251001 for lower cost/latency
# ANTHROPIC_EFFORT=low                      # set empty to omit
# Option B2 — Groq (fast hosted open models, OpenAI-compatible) — used by "What Would You Do?" and all AI features
# AI_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b            # supports strict JSON schema output; llama-3.3-70b-versatile also works (JSON mode)
# GROQ_REASONING_EFFORT=low                 # for gpt-oss models; set empty to omit
# Option B — Ollama on this machine (free, private)
# AI_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5:7b                   # any chat model you have pulled (`ollama pull qwen2.5:7b`)
# OPENAI_BASE_URL=http://localhost:11434/v1
# Option C — any OpenAI-compatible API (OpenAI, LM Studio, vLLM, …)
# AI_PROVIDER=openai
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=...
# OPENAI_API_KEY=...
# AI_TIMEOUT_MS=90000

# ================= Private AI for family memories + activity reports =================
# Remembrance stories and report summaries use ONLY a local model (never the cloud) unless you allow it.
# Install Ollama (https://ollama.com), then:  ollama pull qwen2.5:7b
# LOCAL_AI=on                                   # "off" = build stories directly from the caretaker's notes (no AI)
# LOCAL_AI_BASE_URL=http://localhost:11434/v1   # any OpenAI-compatible server on your machine/network
# LOCAL_AI_MODEL=recallia-remember              # the fine-tuned model; built automatically from finetune/recallia-remember.Q4_K_M.gguf
# LOCAL_AI_FALLBACK_MODEL=qwen2.5:3b            # used until the fine-tuned model exists (Ollama downloads it once, ~2 GB)
# LOCAL_AI_AUTO_SETUP=on                        # download / build / pre-load the private model when Recallia starts
# LOCAL_AI_KEEP_ALIVE=30m                       # keep the model in memory so stories start instantly
# LOCAL_AI_PREBUILD=on                          # rewrite stories in the background as soon as a caretaker adds something
# PRIVATE_AI_ALLOW_CLOUD=false                  # true = fall back to the main AI_PROVIDER for private data (not recommended)
# FIELD_ENCRYPTION_KEY=                         # base64 32 bytes for phone-number encryption; auto-created in data/field.key if unset

# ================= Hospital booking (Doctor Helper) — HL7 FHIR R4 =================
# FHIR_BASE_URL=https://fhir.your-hospital.example/r4
# FHIR_BEARER_TOKEN=
# FHIR_PATIENT_IDENTIFIER_SYSTEM=https://your-hospital.example/mrn   # users type their hospital number
# FHIR_APPOINTMENT_STATUS=booked                                     # or "proposed" if the hospital confirms later
# BOOKING_PROVIDER_NAME=City Hospital

# ================= Web Push =================
# Keys are generated automatically and stored in the database if unset.
# VAPID_SUBJECT=mailto:you@example.org        # required by push services in production
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ================= 3D home (Unreal Engine Pixel Streaming) — see unreal/README.md =================
# UNREAL_SIGNALLING_URL=wss://ue.your-domain.example
